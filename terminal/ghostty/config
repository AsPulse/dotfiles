font-feature = -dlig

font-size = 12
font-family = "JetBrainsMono Nerd Font"
font-family = "FOT-TsukuOldGothic Std D"
# font-style-bold は全ファミリー共通なので、JetBrainsMono と同じ ExtraBold を持つ和文フォントを太字に使う。
# FOT-TsukuOldGothic の太いウェイトはスタイル名が B / E で一致しない。
font-family-bold = "JetBrainsMono Nerd Font"
font-family-bold = "Noto Sans JP"
font-style-bold = "ExtraBold"


theme = "Catppuccin Macchiato"

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

macos-option-as-alt = true

keybind = alt+left=unbind
keybind = alt+right=unbind

adjust-underline-position = 1
adjust-underline-thickness = 2
